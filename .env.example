# Copy to .env. Keep this file on your computer; never commit real credentials.
VAPI_API_KEY=
VAPI_PUBLIC_KEY=
VAPI_WEBHOOK_SECRET=
VAPI_ASSISTANT_ID=
VAPI_SERVER_CREDENTIAL_ID=
# Public HTTPS origin for /webhooks/vapi, e.g. a Cloudflare Tunnel URL.
PUBLIC_BASE_URL=
# Comparison profiles are local configuration until provision_vapi.py --apply.
# Defaults preserve the existing assistant design. CLI flags override these.
VAPI_MODEL_PROFILE=baseline
VAPI_VOICE_PROFILE=elliot-v2
# soniox-v5-auto requests automatic recognition and code-switching via Vapi.
# Legacy profile retained for comparison; validate provider entitlement live.
VAPI_TRANSCRIBER_PROFILE=soniox-v5-auto
# BYOK secrets stay local; profiles never embed them in assistant payloads.
GEMINI_API_KEY=
# Distinct random bearer token for Vapi-to-gateway authentication.
GEMINI_GATEWAY_SECRET=
# Optional Gemini speech output through our dedicated custom-voice endpoint.
# Select VAPI_VOICE_PROFILE=gemini-3.8-flash-lite-tts explicitly for a test assistant.
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_BEARER_SECRET=
VAPI_CUSTOM_TTS_URL=
VAPI_CUSTOM_TTS_CREDENTIAL_ID=
ELEVENLABS_API_KEY=
# Optional read-only JEV benchmark; this key does not enable live classification.
TYPESAFE_API_KEY=
# Narrow first-turn English static FAQ route; no booking/tool authority.
SERVICEVOICE_JEV_FAQ=off
# Guarded narration from verified proposal/commit receipts. Default off;
# enable only after the gateway/voice comparison passes for your deployment.
SERVICEVOICE_RECEIPT_NARRATION=off
# Exact Gemini 3.8 requires our custom adapter until native support is verified.
# Base URL (Vapi appends /chat/completions), e.g. https://HOST/llm
VAPI_CUSTOM_LLM_URL=
VAPI_CUSTOM_LLM_CREDENTIAL_ID=
# Saved Vapi 11labs credential (optional when using Vapi's default integration).
VAPI_ELEVENLABS_CREDENTIAL_ID=
VAPI_ELEVENLABS_VOICE_ID=sarah
# Runtime files stay outside the distributable project by default.
SERVICEVOICE_DB=.local/servicevoice.sqlite3
# Loopback-only by default; do not expose the demo without adding user auth.
SERVICEVOICE_HOST=127.0.0.1
SERVICEVOICE_PORT=8765
SERVICEVOICE_WEBHOOK_PORT=8766
# Single-process capacity. demo10 admits at most 10 combined browser/phone calls
# and permits 10 overlapping model requests; it is not a provider quota upgrade.
# The Lightsail package uses default (four). Restart after changes.
SERVICEVOICE_CAPACITY_PROFILE=default
# Optional positive integer overrides (admission settings must cover max calls):
# SERVICEVOICE_MAX_LIVE_CALLS=10
# SERVICEVOICE_GATEWAY_CONCURRENCY=10
# SERVICEVOICE_PHONE_HTTP_CAPACITY=16
# SERVICEVOICE_PHONE_WORKERS=10
# SERVICEVOICE_PHONE_ADMISSIONS_PER_MINUTE=20
# Optional inbound phone admission. Disabled until a separate saved Vapi phone
# assistant, phone number and server credential are configured and verified.
# Restart after changing these values; the ingress identity is frozen at startup.
# Phone-number assistant-request and phone-assistant events must use the public
# /webhooks/vapi/inbound route with this dedicated bearer credential.
SERVICEVOICE_TELEPHONY_ENABLED=off
VAPI_PHONE_WEBHOOK_SECRET=
VAPI_PHONE_ORG_ID=
VAPI_PHONE_NUMBER_ID=
VAPI_PHONE_ASSISTANT_ID=
# Saved provider credential identifier for later explicit phone provisioning.
# It is not a credential value and does not itself enable admission.
VAPI_PHONE_SERVER_CREDENTIAL_ID=
# Optional content-free LangSmith tracing. Default disabled; keep secrets local.
# Endpoint must match the account region (this one is AWS US).
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
LANGSMITH_PROJECT=servicevoice-local
# Optional UUID from Settings; a display name such as Workspace 1 is not an ID.
LANGSMITH_WORKSPACE_ID=
SERVICEVOICE_LANGSMITH_ENABLED=off
# Optional bounded, content-free timing SQLite file beside SERVICEVOICE_DB.
# The worker writes asynchronously and never shares the booking writer lock.
SERVICEVOICE_TIMING_PERSISTENCE=off
SERVICEVOICE_ENVIRONMENT=local
SERVICEVOICE_LANGSMITH_SAMPLE_RATE=1.0
# A conservative local budget, not an account-wide billing guarantee.
SERVICEVOICE_LANGSMITH_MONTHLY_SPAN_LIMIT=1000
SERVICEVOICE_LANGSMITH_BUDGET_PATH=.local/langsmith-budget.sqlite3
