; REVIEW/RESOLVE BEFORE USE. No UDP/plain-RTP fallback is configured.
[global]
type=global
endpoint_identifier_order=ip

[transport-phone-bridge-tls]
type=transport
protocol=tls
bind=0.0.0.0:5061
method=tlsv1_2
cert_file=@TLS_CERTIFICATE_FILE@
priv_key_file=@TLS_PRIVATE_KEY_FILE@
external_signaling_address=@PUBLIC_SIP_HOST@
external_media_address=@PUBLIC_MEDIA_ADDRESS@
local_net=127.0.0.0/8
verify_client=no
require_client_cert=no

[vapi-owned-bridge]
type=endpoint
context=owned-phone-bridge
disallow=all
allow=ulaw
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
media_encryption=sdes
media_encryption_optimistic=no
dtmf_mode=rfc4733
rtp_timeout=15
rtp_timeout_hold=15
allow_transfer=no

[vapi-owned-bridge-identify]
type=identify
endpoint=vapi-owned-bridge
; Official US signaling addresses; reverify before actual deployment.
match=44.229.228.186/32
match=44.238.177.138/32
