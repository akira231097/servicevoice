# Copy OUTSIDE the checkout as /etc/servicevoice/private.env, owner-only mode0600.
# Raw key=value format: no quotes, shell commands or variable interpolation.
# These are runtime credentials/identities. The Vapi admin key is NOT needed here.
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_API_KEY
GEMINI_GATEWAY_SECRET=REPLACE_WITH_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VAPI_PHONE_WEBHOOK_SECRET=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
VAPI_PHONE_ORG_ID=REPLACE_WITH_CANONICAL_UUID
VAPI_PHONE_NUMBER_ID=REPLACE_WITH_CANONICAL_UUID
VAPI_PHONE_ASSISTANT_ID=REPLACE_WITH_DEDICATED_PHONE_ASSISTANT_UUID
# Required while SERVICEVOICE_JEV_FAQ=on; remove this line if explicitly off.
TYPESAFE_API_KEY=REPLACE_WITH_TYPESAFE_API_KEY
# Optional: add only when enabling content-free LangSmith export in settings.
# LANGSMITH_API_KEY=REPLACE_WITH_LANGSMITH_KEY
# LANGSMITH_WORKSPACE_ID=REPLACE_WITH_CANONICAL_WORKSPACE_UUID
# LANGSMITH_ENDPOINT=https://aws.api.smith.langchain.com
