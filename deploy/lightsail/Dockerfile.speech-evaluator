# Separate review image; never rebuild or restart the accepted voice service.
# Supply a reviewed local tag and verify its resolved ID before building.
# A bare sha256 image ID is not a valid BuildKit FROM reference.
ARG SERVICEVOICE_BASE_IMAGE
FROM ${SERVICEVOICE_BASE_IMAGE}
USER root
RUN mkdir -p /evaluations && chown 10001:10001 /evaluations
# Copy the complete review/projection closure. Diagnostics uses the fixed
# generation-field allowlist in observability; the old base lacks that helper.
# call_review_presentation renders the readable review and trace children.
COPY app/domain.py app/live_eval_evidence.py app/live_evaluations.py app/diagnostics.py app/evaluation_spans.py app/generation_observability.py app/observability.py app/provider_logs.py app/call_review_presentation.py /app/app/
USER 10001:10001
ENTRYPOINT ["python", "-m", "app.live_evaluations"]
CMD []
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 CMD ["python","-c","import json,os,time\nfrom pathlib import Path\ntry:\n    h=json.loads((Path(os.getenv('SERVICEVOICE_EVAL_OUTBOX','/evaluations/outbox.sqlite3')).parent/'health.json').read_text())\n    ok=time.time()-h['at']<180 and not h.get('alerts') and not any(h.get(k) for k in ('worker_error','source_discovery_error','provider_discovery_error'))\nexcept (OSError,ValueError,KeyError):\n    ok=False\nraise SystemExit(0 if ok else 1)\n"]
