# Copy OUTSIDE the checkout, for example /etc/servicevoice/settings.env.
# Do not put any credential in this settings file.
SERVICEVOICE_PUBLIC_HOST=REPLACE_WITH_STATIC_PUBLIC_IPV4_OR_DNS_NAME
SERVICEVOICE_ACME_EMAIL=REPLACE_WITH_YOUR_EMAIL
SERVICEVOICE_PRIVATE_ENV_FILE=/etc/servicevoice/private.env
# Change only after a verified restore and a deliberate stop/recreate.
SERVICEVOICE_DATABASE_PATH=/data/servicevoice.sqlite3
# Gemini speech release: configure the saved Vapi assistant separately to match.
VAPI_VOICE_PROFILE=gemini-3.8-flash-lite-tts
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
# Keep the existing narrow verified-static-FAQ route; requires TYPESAFE_API_KEY.
SERVICEVOICE_JEV_FAQ=on
# Optional content-free, asynchronous export with a local 1000-span monthly cap.
SERVICEVOICE_LANGSMITH_ENABLED=off
