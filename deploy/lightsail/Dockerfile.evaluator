# Reuse the deployed, locked runtime. Building this image does not recreate the
# voice server. Record the resolved base image ID in the deployment receipt.
ARG SERVICEVOICE_BASE_IMAGE=servicevoice-app:lightsail
FROM ${SERVICEVOICE_BASE_IMAGE}
USER root
RUN mkdir -p /evaluations && chown 10001:10001 /evaluations
COPY app/live_eval_evidence.py app/live_evaluations.py /app/app/
USER 10001:10001
ENTRYPOINT ["python", "-m", "app.live_evaluations"]
CMD []
HEALTHCHECK --interval=30s --timeout=3s --start-period=60s --retries=3 CMD ["python", "-m", "app.live_evaluations", "--health"]
