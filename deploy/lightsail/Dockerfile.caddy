FROM caddy:2.11.7-alpine@sha256:d8542f48d34a9cf4e4c11a478865229840e87e4c96ea3f439101f31a5d35f75f
# The upstream binary has cap_net_bind_service=ep. Remove that file capability:
# cap_drop=ALL would otherwise make exec fail, and ports8080/8443 need no privilege.
RUN setcap -r /usr/bin/caddy \
    && mkdir -p /data/caddy /config/caddy && chown -R 10001:10001 /data /config
USER 10001:10001
# Ports inside the container are unprivileged; the host maps80/443 to these.
EXPOSE 8080 8443
