# Private, owner-only /etc/servicevoice/evaluation.env. Never commit real values.
# The voice container does not receive this Vapi administrative key.
VAPI_EVALUATION_API_KEY=REPLACE_WITH_EXISTING_VAPI_PRIVATE_API_KEY
GEMINI_API_KEY=REPLACE_WITH_EXISTING_GEMINI_KEY
LANGSMITH_API_KEY=REPLACE_WITH_EXISTING_LANGSMITH_KEY
LANGSMITH_WORKSPACE_ID=REPLACE_WITH_WORKSPACE_UUID
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
VAPI_PHONE_ORG_ID=REPLACE_WITH_PHONE_ORGANIZATION_UUID
# Exact assistant allowlist also discovers calls that failed before session binding.
VAPI_EVAL_ASSISTANT_ID=REPLACE_WITH_PHONE_ASSISTANT_UUID
# Counts model attempts, including errors; reports without a judge stay uncertain.
SERVICEVOICE_EVAL_MONTHLY_LIMIT=200
SERVICEVOICE_EVAL_LATENCY_TARGET_MS=2000
SERVICEVOICE_EVAL_LOOKBACK_HOURS=24
SERVICEVOICE_EVAL_POLL_SECONDS=30
