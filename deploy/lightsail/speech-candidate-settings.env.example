# Public settings, outside checkout, owner-only. No credentials in this file.
SERVICEVOICE_PUBLIC_HOST=REPLACE_WITH_ACCEPTED_STATIC_PUBLIC_ADDRESS
SERVICEVOICE_CANDIDATE_PRIVATE_ENV_FILE=/etc/servicevoice/speech-candidate-business.env
SERVICEVOICE_SPEECH_PRIVATE_ENV_FILE=/etc/servicevoice/speech-candidate-tts.env
# Exact separately built image containing the standalone TTS server, no remote pull.
SERVICEVOICE_SPEECH_IMAGE=REPLACE_WITH_REVIEWED_LOCAL_IMAGE_ID
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_TTS_VOICE=Kore
